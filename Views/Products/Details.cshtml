@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var product = Model.Product;
    var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl)
        ? "https://images.unsplash.com/photo-1472851294608-062f824d29cc?auto=format&fit=crop&w=900&q=80"
        : product.ImageUrl;
}

<section class="section-band product-detail-section">
    <div class="container-fluid site-container">
        <div class="breadcrumb-line">
            <a asp-controller="Home" asp-action="Index">Cửa hàng</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@product.CategoryId">@product.Category.Name</a>
            <i class="bi bi-chevron-right"></i>
            <span>@product.Name</span>
        </div>

        <div class="product-detail-grid">
            <div class="detail-media">
                <img src="@imageUrl" alt="@product.Name" />
            </div>
            <div class="detail-content">
                <span class="eyebrow">@product.Brand</span>
                <h1>@product.Name</h1>
                <div class="detail-rating">
                    <span><i class="bi bi-star-fill"></i> @product.Rating.ToString("0.0")</span>
                    <span>Đã bán @product.Sold</span>
                    <span>@(product.Stock > 0 ? $"Còn {product.Stock} sản phẩm" : "Hết hàng")</span>
                </div>
                <div class="detail-price">
                    <strong>@product.Price.ToString("N0")đ</strong>
                    @if (product.OldPrice.HasValue && product.OldPrice.Value > product.Price)
                    {
                        <del>@product.OldPrice.Value.ToString("N0")đ</del>
                    }
                </div>
                <p>@product.Description</p>
                <form class="detail-cart-form" asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@product.ProductId" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <label>
                        Số lượng
                        <input type="number" name="quantity" min="1" max="@Math.Max(product.Stock, 1)" value="1" />
                    </label>
                    @if (product.Stock > 0)
                    {
                        <button class="btn-main" type="submit">
                            <i class="bi bi-cart-plus"></i>
                            Thêm vào giỏ
                        </button>
                    }
                    else
                    {
                        <button class="btn-main" type="button" disabled>
                            <i class="bi bi-cart-x"></i>
                            Hết hàng
                        </button>
                    }
                </form>
            </div>
        </div>
    </div>
</section>

@if (Model.RelatedProducts.Any())
{
    <section class="section-band">
        <div class="container-fluid site-container">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Liên quan</span>
                    <h2>Có thể bạn cũng thích</h2>
                </div>
            </div>
            <div class="product-grid compact-grid">
                @foreach (var related in Model.RelatedProducts)
                {
                    <partial name="_ProductCard" model="related" />
                }
            </div>
        </div>
    </section>
}
