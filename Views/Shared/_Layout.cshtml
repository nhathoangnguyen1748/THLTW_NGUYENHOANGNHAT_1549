@inject AdminAuthorizationService AdminAccess
@{
    var cartCount = 0;
    var cartJson = Context.Session.GetString("SHOP_CART");
    if (!string.IsNullOrWhiteSpace(cartJson))
    {
        try
        {
            cartCount = JsonSerializer.Deserialize<List<CartSessionItem>>(cartJson)?.Sum(item => item.Quantity) ?? 0;
        }
        catch (JsonException)
        {
            cartCount = 0;
        }
    }

    var controller = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    var isAdmin = string.Equals(controller, "Admin", StringComparison.OrdinalIgnoreCase);
    var canViewAdmin = AdminAccess.IsAdmin(Context);
    var adminName = AdminAccess.GetDisplayName(Context);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NH Mall</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebBanHang.styles.css" asp-append-version="true" />
</head>
<body class="@(isAdmin ? "admin-shell" : "shop-shell")">
    <header class="site-header">
        <div class="top-strip">
            <div class="container-fluid site-container d-flex justify-content-between align-items-center gap-3">
                <span>Freeship cho đơn từ 1.000.000đ</span>
                <span class="d-none d-md-inline">Hotline 1900 6688 | Giao nhanh toàn quốc</span>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg main-nav">
            <div class="container-fluid site-container">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-bag-check-fill"></i></span>
                    <span>NH Mall</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <form class="search-bar ms-lg-4 me-lg-auto my-3 my-lg-0" asp-controller="Home" asp-action="Index" method="get">
                        <i class="bi bi-search"></i>
                        <input type="search" name="search" value="@Context.Request.Query["search"]" placeholder="Tìm sản phẩm, thương hiệu..." aria-label="Tìm kiếm" />
                        <button type="submit" title="Tìm kiếm"><i class="bi bi-arrow-right"></i></button>
                    </form>
                    <ul class="navbar-nav nav-actions align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Cửa hàng</a>
                        </li>
                        @if (canViewAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Quản trị</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link cart-link" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
                                <i class="bi bi-cart3"></i>
                                <span>Giỏ hàng</span>
                                <strong>@cartCount</strong>
                            </a>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(adminName))
                        {
                            <li class="nav-item admin-identity">
                                <span>@adminName</span>
                                <form asp-controller="Admin" asp-action="Logout" method="post">
                                    <button type="submit" title="Đăng xuất"><i class="bi bi-box-arrow-right"></i></button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="GoogleLogin">
                                    <i class="bi bi-google"></i>
                                    <span>Đăng nhập Google</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Toast"] is string toast)
    {
        <div class="container-fluid site-container">
            <div class="toast-line">
                <i class="bi bi-check-circle-fill"></i>
                <span>@toast</span>
            </div>
        </div>
    }

    <main role="main" class="page-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-fluid site-container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>&copy; 2026 NH Mall</span>
            <span>Đồ án ASP.NET Core MVC kết nối SQL Server</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
