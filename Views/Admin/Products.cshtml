@model List<Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<section class="admin-layout section-band">
    <div class="container-fluid site-container">
        <div class="admin-heading">
            <div>
                <span class="eyebrow">Quản trị</span>
                <h1>Sản phẩm</h1>
            </div>
            <div class="admin-tabs">
                <a asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> Tổng quan</a>
                <a class="active" asp-controller="Admin" asp-action="Products"><i class="bi bi-box-seam"></i> Sản phẩm</a>
                <a asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags"></i> Danh mục</a>
                <a asp-controller="Admin" asp-action="Orders"><i class="bi bi-receipt"></i> Đơn hàng</a>
            </div>
            <a class="btn-main" asp-controller="Admin" asp-action="ProductCreate">
                <i class="bi bi-plus-lg"></i>
                Thêm sản phẩm
            </a>
        </div>

        <div class="table-shell">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Kho</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <div class="table-product">
                                    <img src="@product.ImageUrl" alt="@product.Name" />
                                    <span>
                                        <strong>@product.Name</strong>
                                        <small>@product.Brand</small>
                                    </span>
                                </div>
                            </td>
                            <td>@product.Category.Name</td>
                            <td>@product.Price.ToString("N0")đ</td>
                            <td>@product.Stock</td>
                            <td>
                                <span class="status-pill @(product.IsActive ? "success" : "muted")">
                                    @(product.IsActive ? "Đang bán" : "Đang ẩn")
                                </span>
                            </td>
                            <td class="table-actions">
                                <a class="icon-button ghost" asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId" title="Xem">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="icon-button ghost" asp-controller="Admin" asp-action="ProductEdit" asp-route-id="@product.ProductId" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Admin" asp-action="ProductDelete" asp-route-id="@product.ProductId" method="post">
                                    <button class="icon-button ghost danger" type="submit" title="Ẩn/hiện">
                                        <i class="bi bi-power"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
