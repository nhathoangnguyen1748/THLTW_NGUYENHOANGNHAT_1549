@model AdminLoginViewModel
@{
    ViewData["Title"] = "Đăng nhập admin";
}

<section class="admin-login-section">
    <div class="login-panel">
        <span class="eyebrow">Quản trị hệ thống</span>
        <h1>Đăng nhập quản trị</h1>
        <p>Tài khoản mẫu: <strong>admin</strong> / <strong>admin123</strong></p>
        <form asp-controller="Admin" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label>
                Tên đăng nhập
                <input asp-for="Username" autocomplete="username" />
                <span asp-validation-for="Username"></span>
            </label>
            <label>
                Mật khẩu
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </label>
            <button class="btn-main w-100" type="submit">
                <i class="bi bi-shield-lock"></i>
                Đăng nhập
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
