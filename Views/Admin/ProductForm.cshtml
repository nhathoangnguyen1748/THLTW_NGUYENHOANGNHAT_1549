@model ProductFormViewModel
@{
    var isEdit = Model.ProductId.HasValue;
    var actionName = isEdit ? "ProductEdit" : "ProductCreate";
    ViewData["Title"] = isEdit ? "Sửa sản phẩm" : "Thêm sản phẩm";
}

<section class="admin-layout section-band">
    <div class="container-fluid site-container">
        <div class="admin-heading">
            <div>
                <span class="eyebrow">Quản trị</span>
                <h1>@ViewData["Title"]</h1>
            </div>
            <a class="btn-soft" asp-controller="Admin" asp-action="Products">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>
        </div>

        <form asp-controller="Admin" asp-action="@actionName" method="post" class="form-panel wide-form">
            @if (isEdit)
            {
                <input type="hidden" asp-for="ProductId" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid">
                <label>
                    Tên sản phẩm
                    <input asp-for="Name" />
                    <span asp-validation-for="Name"></span>
                </label>
                <label>
                    Slug
                    <input asp-for="Slug" />
                    <span asp-validation-for="Slug"></span>
                </label>
                <label>
                    Danh mục
                    <select asp-for="CategoryId">
                        <option value="0">Chọn danh mục</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryId">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId"></span>
                </label>
                <label>
                    Thương hiệu
                    <input asp-for="Brand" />
                    <span asp-validation-for="Brand"></span>
                </label>
                <label>
                    Giá bán
                    <input asp-for="Price" type="number" min="0" step="1000" />
                    <span asp-validation-for="Price"></span>
                </label>
                <label>
                    Giá cũ
                    <input asp-for="OldPrice" type="number" min="0" step="1000" />
                    <span asp-validation-for="OldPrice"></span>
                </label>
                <label>
                    Tồn kho
                    <input asp-for="Stock" type="number" min="0" />
                    <span asp-validation-for="Stock"></span>
                </label>
                <label>
                    Đã bán
                    <input asp-for="Sold" type="number" min="0" />
                    <span asp-validation-for="Sold"></span>
                </label>
                <label>
                    Đánh giá
                    <input asp-for="Rating" type="number" min="1" max="5" step="0.1" />
                    <span asp-validation-for="Rating"></span>
                </label>
                <label>
                    Ảnh sản phẩm
                    <input asp-for="ImageUrl" />
                    <span asp-validation-for="ImageUrl"></span>
                </label>
            </div>
            <label>
                Mô tả
                <textarea asp-for="Description" rows="5"></textarea>
                <span asp-validation-for="Description"></span>
            </label>
            <div class="switch-row">
                <label>
                    <input asp-for="IsFeatured" />
                    Sản phẩm nổi bật
                </label>
                <label>
                    <input asp-for="IsActive" />
                    Đang hiển thị
                </label>
            </div>
            <button class="btn-main" type="submit">
                <i class="bi bi-save"></i>
                Lưu sản phẩm
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
