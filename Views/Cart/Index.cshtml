@model CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<section class="section-band cart-section">
    <div class="container-fluid site-container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Giỏ hàng</span>
                <h1>Sản phẩm đã chọn</h1>
            </div>
            <a class="btn-soft" asp-controller="Home" asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Tiếp tục mua
            </a>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <i class="bi bi-cart3"></i>
                <h3>Giỏ hàng đang trống</h3>
                <a asp-controller="Home" asp-action="Index">Khám phá sản phẩm</a>
            </div>
        }
        else
        {
            <div class="cart-grid">
                <div class="cart-list">
                    @foreach (var item in Model.Items)
                    {
                        <article class="cart-item">
                            <img src="@item.ImageUrl" alt="@item.Name" />
                            <div>
                                <h2>@item.Name</h2>
                                <span>@item.Price.ToString("N0")đ</span>
                                <small>Còn @item.Stock sản phẩm</small>
                            </div>
                            <form asp-controller="Cart" asp-action="Update" method="post" class="quantity-form">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" min="1" max="@Math.Max(item.Stock, 1)" value="@item.Quantity" />
                                <button type="submit" title="Cập nhật"><i class="bi bi-arrow-repeat"></i></button>
                            </form>
                            <strong>@item.LineTotal.ToString("N0")đ</strong>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button class="icon-button ghost danger" type="submit" title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </article>
                    }
                    <form asp-controller="Cart" asp-action="Clear" method="post">
                        <button class="btn-soft danger" type="submit">
                            <i class="bi bi-x-circle"></i>
                            Xóa giỏ hàng
                        </button>
                    </form>
                </div>

                <aside class="order-summary">
                    <h2>Tạm tính</h2>
                    <div>
                        <span>@Model.TotalQuantity sản phẩm</span>
                        <strong>@Model.Subtotal.ToString("N0")đ</strong>
                    </div>
                    <div>
                        <span>Phí vận chuyển</span>
                        <strong>@Model.ShippingFee.ToString("N0")đ</strong>
                    </div>
                    <div class="summary-total">
                        <span>Tổng cộng</span>
                        <strong>@Model.Total.ToString("N0")đ</strong>
                    </div>
                    <a class="btn-main w-100" asp-controller="Cart" asp-action="Checkout">
                        <i class="bi bi-credit-card"></i>
                        Thanh toán
                    </a>
                </aside>
            </div>
        }
    </div>
</section>
